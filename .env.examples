DEEPGRAM_API_KEY=your_deepgram_api_key_here
SARVAMAI_API_KEY=your_sarvamai_api_key_here
# Google Calendar (OAuth desktop client JSON from Google Cloud Console)
GOOGLE_CLIENT_SECRET_FILE=client_secret_XXXX.apps.googleusercontent.com.json
# Optional: where to store OAuth tokens after first browser login
# GOOGLE_TOKEN_FILE=token.json
# Optional: IANA timezone for naive date-times from the model, e.g. America/Los_Angeles
# GOOGLE_CALENDAR_TIMEZONE=UTC
