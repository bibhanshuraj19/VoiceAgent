# API keys
DEEPGRAM_API_KEY=your_deepgram_key
NEBIUS_API_KEY=your_nebius_key
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=your_voice_id

# Deepgram STT
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=multi
DEEPGRAM_ENDPOINTING_MS=600

# Nebius LLM
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/
NEBIUS_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
NEBIUS_LLM_TEMPERATURE=0.3
NEBIUS_LLM_MAX_TOKENS=320
NEBIUS_REQUEST_TIMEOUT=30.0

# ElevenLabs TTS
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=pcm_16000
ELEVENLABS_LATENCY_MODE=3

# Runtime
LLM_FIRST_TOKEN_TIMEOUT=6.0
LLM_CONNECT_RETRY_ATTEMPTS=1
TTS_CONNECT_RETRY_ATTEMPTS=1
TOOL_TIMEOUT_SECONDS=8.0
NO_TRANSCRIPT_NUDGE_SECONDS=4.0
BARGE_IN_ENABLED=true
BARGE_IN_RMS_THRESHOLD=950
BARGE_IN_FRAMES_REQUIRED=3

# Local web UI
VOICE_UI_ENABLED=true
VOICE_UI_HOST=127.0.0.1
VOICE_UI_PORT=8765

# Google Calendar OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
